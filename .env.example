# Публичный адрес сайта. Для локальной разработки можно оставить localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Необязательно. Если ID не указан, кнопки записи ведут на рабочую запись в Яндекс Картах.
NEXT_PUBLIC_YCLIENTS_WIDGET_ID=

# Необязательно. Числовой ID счётчика Яндекс Метрики.
NEXT_PUBLIC_YANDEX_METRIKA_ID=
